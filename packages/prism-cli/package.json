{
  "name": "@prism/cli",
  "version": "0.2.0",
  "description": "PRISM CLI — Interactive pipeline agent with slash commands",
  "type": "module",
  "bin": {
    "prism": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --out-dir dist --clean",
    "dev": "tsup src/index.ts --format esm --out-dir dist --watch",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "vitest"
  },
  "dependencies": {
    "@prism/sdk": "file:../prism-sdk",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.0",
    "readline": "^1.3.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
