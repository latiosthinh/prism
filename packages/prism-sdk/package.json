{
  "name": "@prism/sdk",
  "version": "0.1.0",
  "description": "PRISM SDK — Unified LLM and Agent runtime wrapping pi-ai and pi-agent-core",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-agent-core": "^0.74.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "ai",
    "llm",
    "agent",
    "multi-provider",
    "anthropic",
    "openai",
    "prism"
  ],
  "author": "latiosthinh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/latiosthinh/prism",
    "directory": "packages/prism-sdk"
  },
  "bugs": {
    "url": "https://github.com/latiosthinh/prism/issues"
  },
  "homepage": "https://github.com/latiosthinh/prism#readme",
  "publishConfig": {
    "access": "public"
  }
}
